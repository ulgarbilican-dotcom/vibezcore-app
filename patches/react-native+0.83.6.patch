@@ -620,10 +620,54 @@ if (ReactNativeFeatureFlags.reduceDefaultPropsInText()) {
   _TextImpl = TextImplLegacy;
 }
 
+const TextImplInner = _TextImpl;
+// VIBEZCORE (20 okt 2026, operator: "dit moet altijd in onze fontstijl"):
+// - Inter is het lettertype van elke tekst zonder eigen fontFamily. Vroeger
+//   via Text.defaultProps, maar React 19 negeert defaultProps → zulke tekst
+//   viel terug op het systeemlettertype (Roboto/SF, per toestel anders).
+//   Geneste tekst zonder gewicht erft gewoon van zijn ouder; een fontWeight
+//   zonder fontFamily wordt het juiste Inter-gewicht (Android tekent anders
+//   een nagemaakt vet).
+// - Grote letters in de toestelinstellingen tellen mee, begrensd tot 1,3x
+//   zodat knoppen en labels op geen enkel toestel worden afgeknipt. Een
+//   eigen maxFontSizeMultiplier per Text wint.
+const VZ_INTER = {
+  '100': 'Inter_400Regular',
+  '200': 'Inter_400Regular',
+  '300': 'Inter_400Regular',
+  '400': 'Inter_400Regular',
+  normal: 'Inter_400Regular',
+  '500': 'Inter_500Medium',
+  '600': 'Inter_600SemiBold',
+  '700': 'Inter_700Bold',
+  bold: 'Inter_700Bold',
+  '800': 'Inter_800ExtraBold',
+  '900': 'Inter_900Black',
+};
 const TextImpl: component(
   ref?: React.RefSetter<TextForwardRef>,
   ...props: TextProps
-) = _TextImpl;
+) = function TextWithBrandDefaults(props) {
+  const nested = useContext(TextAncestorContext);
+  let style = props.style;
+  const flat = flattenStyle(style);
+  if (flat == null || flat.fontFamily == null) {
+    const weight = flat != null ? flat.fontWeight : undefined;
+    if (weight != null || !nested) {
+      const family = VZ_INTER[String(weight != null ? weight : '400')] || 'Inter_400Regular';
+      style = [{fontFamily: family}, style, weight != null ? {fontWeight: 'normal'} : null];
+    }
+  }
+  return (
+    <TextImplInner
+      {...props}
+      style={style}
+      maxFontSizeMultiplier={
+        props.maxFontSizeMultiplier === undefined ? 1.3 : props.maxFontSizeMultiplier
+      }
+    />
+  );
+};
 
 TextImpl.displayName = 'Text';
 

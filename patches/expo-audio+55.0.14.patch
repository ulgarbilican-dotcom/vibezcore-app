+      .setAlbumTitle(meta.albumTitle)
+      .setArtworkUri(meta.artworkUrl?.let { Uri.parse(it.toString()) })
+      .build()
+    if (item.mediaMetadata == md) return
+    try {
+      exo.replaceMediaItem(exo.currentMediaItemIndex, item.buildUpon().setMediaMetadata(md).build())
+    } catch (_: Exception) {
+    }
+  }
+
+  private fun applySessionMetadataOnMain() {
+    appContext?.mainQueue?.launch { applySessionMetadata() }

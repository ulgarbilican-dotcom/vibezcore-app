<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- Android 14+: een foreground service van het type "health" vereist
         naast FOREGROUND_SERVICE_HEALTH ook één van ACTIVITY_RECOGNITION /
         BODY_SENSORS / HIGH_SAMPLING_RATE_SENSORS. Deze laatste is een
         gewone (install-time) toestemming — geen dialoog, geen sensorgebruik. -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="VIBEZCORE"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true">

        <!-- Niet standalone: de telefoon-app zet de catalogus (toestanden,
             technieken, toegang) klaar. Daarna start het horloge State
             Control en Breathwork ook zelf, zonder telefoon in de buurt. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/VzWearTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 13 okt 2026: een toestand kiezen en op het horloge zelf starten -->
        <activity
            android:name=".TechniqueActivity"
            android:exported="false"
            android:theme="@style/VzWearTheme" />

        <activity
            android:name=".StateActivity"
            android:exported="false"
            android:theme="@style/VzWearTheme" />

        <activity
            android:name=".ModesActivity"
            android:exported="false"
            android:theme="@style/VzWearTheme" />

        <activity
            android:name=".StateControlActivity"
            android:exported="false"
            android:theme="@style/VzWearTheme" />

        <activity
            android:name=".StateDurationActivity"
            android:exported="false"
            android:theme="@style/VzWearTheme" />

        <activity
            android:name=".DurationActivity"
            android:exported="false"
            android:theme="@style/VzWearTheme" />

        <service
            android:name=".BreathListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/vibezcore/breath" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/vibezcore/state" />
            </intent-filter>
            <!-- 13 okt 2026: catalogus van de telefoon (bewaard gegeven) -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/vibezcore/catalog" />
            </intent-filter>
        </service>

        <service
            android:name=".WearBreathSessionService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <service
            android:name=".WearStateSessionService"
            android:exported="false"
            android:foregroundServiceType="health" />

    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!-- VIBEZCORE op het horloge (6 okt 2026): dezelfde look als de app en de
     website-mockup — naam met kleurstip, de sessiecirkel, een ronde
     pauzeknop met END eronder. Eén indeling voor State Control en
     breathwork; MainActivity vult hem. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Geen sessie: wachten op de telefoon -->
    <LinearLayout
        android:id="@+id/idleContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIBEZCORE"
            android:textColor="#8A8A8A"
            android:textSize="11sp"
            android:letterSpacing="0.15"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center"
            android:text="Start a session in the VIBEZCORE App"
            android:textColor="#F4F4F4"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Lopende of gepauzeerde sessie -->
    <LinearLayout
        android:id="@+id/sessionContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/nameDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="6dp"
                android:background="#00A3A3" />

            <TextView
                android:id="@+id/nameLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text=""
                android:textColor="#F4F4F4"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.ubili.vibezcoreapp.wear.SessionRingView
            android:id="@+id/ring"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/pauseButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Pause"
            android:scaleType="center"
            android:src="@drawable/ic_vz_pause" />

        <TextView
            android:id="@+id/endButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="28dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center"
            android:text="END"
            android:textColor="#B8FFFFFF"
            android:textSize="10sp"
            android:letterSpacing="0.16"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>

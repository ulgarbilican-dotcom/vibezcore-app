<?xml version="1.0" encoding="utf-8"?>
<!-- VIBEZCORE op het horloge (6 okt 2026): dezelfde look als de app en de
     website-mockup — naam met kleurstip, de sessiecirkel, een ronde
     pauzeknop met END eronder. Eén indeling voor State Control en
     breathwork; MainActivity vult hem. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Geen sessie: wachten op de telefoon -->
    <LinearLayout
        android:id="@+id/idleContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <!-- 12 okt 2026 (operator: "ik zie ons logo er niet staan"): het
             echte woordmerk (zelfde als de app, letterafstand x1,1). -->
        <ImageView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:src="@drawable/vz_vmark" />

        <ImageView
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="VIBEZCORE"
            android:src="@drawable/vz_wordmark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center"
            android:text="Start a session on your phone"
            android:textColor="#F4F4F4"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- Lopende of gepauzeerde sessie. 12 okt 2026 (operator: "cirkel groot,
         bediening aan de binnenkant"): de ring vult het scherm (zoals Apple's
         Workout), naam bovenaan en pauze + END onderaan BINNEN de cirkel. -->
    <FrameLayout
        android:id="@+id/sessionContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <com.ubili.vibezcoreapp.wear.SessionRingView
            android:id="@+id/ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/nameDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="6dp"
                android:background="#00A3A3" />

            <TextView
                android:id="@+id/nameLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="120dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text=""
                android:textColor="#F4F4F4"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/pauseButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Pause"
                android:scaleType="center"
                android:src="@drawable/ic_vz_pause" />

            <TextView
                android:id="@+id/endButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="26dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:gravity="center"
                android:text="END"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:letterSpacing="0.16"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>

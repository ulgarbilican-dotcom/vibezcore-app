<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="VzWearTheme" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- 13 nov 2026 (Google Play WO-V15: "app-icoon van 48x48 dp op een zwarte achtergrond tijdens het opstarten"): het opstartscherm toont
         het echte app-icoon (witte cirkel, zwarte V — hetzelfde als op het horloge) op zwart. Volgt de Wear-handleiding "Add a splash screen"
         (rond icoon = Theme.SplashScreen, 48 dp). Daarna schakelt MainActivity (installSplashScreen) naar VzWearTheme. Vervangt het losse
         V-merkteken zonder icoon van 13 okt 2026. -->
    <style name="VzWearTheme.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/vz_splash</item>
        <item name="postSplashScreenTheme">@style/VzWearTheme</item>
    </style>
</resources>

{
  "expo": {
    "name": "VIBEZCORE",
    "slug": "vibezcore-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/icon_1024.png",
    "scheme": "vibezcoreapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/icon/ios_1024.png",
      "bundleIdentifier": "com.ubili.vibezcoreapp",
      "appleTeamId": "88AL3UW7L7",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeUserID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUsageData",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "icon": "./assets/icon/icon_1024.png",
      "adaptiveIcon": {
        "backgroundColor": "#00A3A3",
        "foregroundImage": "./assets/icon/android_fg.png",
        "backgroundImage": "./assets/icon/android_bg.png",
        "monochromeImage": "./assets/icon/android_mono.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ubili.vibezcoreapp",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.health.WRITE_MINDFULNESS",
        "android.permission.health.READ_RESTING_HEART_RATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#00A3A3",
          "image": "./assets/splash_blank.png",
          "imageWidth": 76,
          "android": {
            "image": "./assets/splash_blank.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/withoutReleaseLint",
      "@react-native-community/datetimepicker",
      "./plugins/withQuickShortcuts",
      "./modules/breath-background/plugin.js",
      "./plugins/withWearApp",
      "./plugins/withPulseCamera",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification_icon.png",
          "color": "#00A3A3"
        }
      ],
      "expo-localization",
      "@bacons/apple-targets",
      [
        "@sentry/react-native",
        {
          "organization": "ulgar-bilican",
          "project": "react-native",
          "url": "https://sentry.io/"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8c47743c-4586-4790-91b5-a1a6508b8e7a"
      },
      "googleWebClientId": "80535193832-hmkidpmb9ki274p5go7rhsli6fgcueht.apps.googleusercontent.com",
      "revenuecatApiKeyAndroid": "goog_KyNEYIhvNNHzFWGdJeCPCmpPxWp",
      "revenuecatApiKeyIos": "appl_fINnAMNHPkMcgTRuFOJuecbFKPL"
    },
    "owner": "ubili",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8c47743c-4586-4790-91b5-a1a6508b8e7a"
    }
  }

<?xml version="1.0" encoding="utf-8"?>
<!-- 27 okt 2026 (operator, keuze A uit de mockup): achtergrond van het adaptieve horloge-icoon volledig ZWART, met een
     dunne lichte rand (wit, ±22%) rond de cirkel — zo valt de cirkel niet weg tegen het zwarte horlogescherm, zoals bij X.
     Eerder: grafiet-verloop (14 okt: "de cirkel moet even groot zijn als de andere"). De cirkel zelf snijdt Wear OS uit
     (adaptief icoon 72 dp, zichtbaar 66 dp); de ring ligt dus op de rand van het zichtbare vlak. 
     27 okt 2026 (avond, operator: "weinig of geen omlijning, zwart op zwart"): ring 1,2 → 2 dp, 22% → 70% wit en 3 → 5 dp naar binnen — op 3 dp lag hij precies op
     de rand die Wear OS wegsnijdt en viel de helft weg. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#000000" />
        </shape>
    </item>
    <item
        android:left="5dp"
        android:top="5dp"
        android:right="5dp"
        android:bottom="5dp">
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="#B3FFFFFF" />
        </shape>
    </item>
</layer-list>

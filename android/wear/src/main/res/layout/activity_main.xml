<?xml version="1.0" encoding="utf-8"?>
<!-- VIBEZCORE op het horloge (6 okt 2026): dezelfde look als de app en de
     website-mockup — naam met kleurstip, de sessiecirkel, een ronde
     pauzeknop met END eronder. Eén indeling voor State Control en
     breathwork; MainActivity vult hem. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Geen sessie: het startscherm (13 okt 2026 — het horloge
         zelfstandig). MainActivity.renderHome vult de lijst: "Again",
         de vijf Breathe-toestanden, of — zonder catalogus — de uitleg om
         de telefoon-app één keer te openen. Draaiende rand scrolt. -->
    <ScrollView
        android:id="@+id/idleContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/homeList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="48dp" />
    </ScrollView>

    <!-- Lopende of gepauzeerde sessie. 12 okt 2026 (operator: "cirkel groot,
         bediening aan de binnenkant"): de ring vult het scherm (zoals Apple's
         Workout), naam bovenaan en pauze + END onderaan BINNEN de cirkel. -->
    <FrameLayout
        android:id="@+id/sessionContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <com.ubili.vibezcoreapp.wear.SessionRingView
            android:id="@+id/ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/nameDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="6dp"
                android:background="#00A3A3" />

            <TextView
                android:id="@+id/nameLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="120dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text=""
                android:textColor="#F4F4F4"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/pauseButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Pause"
                android:scaleType="center"
                android:src="@drawable/ic_vz_pause" />

            <TextView
                android:id="@+id/endButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="26dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:gravity="center"
                android:text="END"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:letterSpacing="0.16"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
